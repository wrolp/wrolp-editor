{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WROLP Editor",
  "version": "0.0.2",
  "identifier": "com.wrolp.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WROLP Editor",
        "width": 1180,
        "height": 740,
        "minWidth": 720,
        "minHeight": 420,
        "decorations": false,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wrolp/wrolp-editor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4MzlGOTgzRTk2RUM4REEKUldUYXlHN3BnL2s1dU1HVm8wQ05lK1IzZmVyVktKNXVvQzNPVG45MHRDWDd2NnN4dUpvanN2UFEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "WROLP",
    "category": "Utility",
    "shortDescription": "WROLP Editor",
    "longDescription": "A simple local text editor: open files from the Explorer context menu, with automatic caching and restore of unsaved drafts.",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
